{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "amd",
      "displayName": "AMD hardware encoding (Release)",
      "description": "MSVC x64 Release build using the AMD hardware Media Foundation encoder. Requires a Visual Studio developer shell.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "WVD_ENABLE_NVENC": false,
        "WVD_NVENC_SDK_DIR": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "amd",
      "configurePreset": "amd"
    }
  ],
  "testPresets": [
    {
      "name": "amd",
      "configurePreset": "amd",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
