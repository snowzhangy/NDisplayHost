<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NDisplayHostWin" Width="1080" Height="740"
        MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="#10141E" Foreground="#EDF1F9" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A4B1C6"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF1F9"/><Setter Property="Background" Value="#283449"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"
                Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6D4FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#142033"/><Setter Property="Background" Value="#E8EEF8"/>
      <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="35"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EDF1F9"/><Setter Property="Background" Value="#101722"/>
      <Setter Property="BorderBrush" Value="#3A4961"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF1F9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1A2230"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="#2B374B"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid Margin="28,22,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <StackPanel><TextBlock x:Name="ProductTitle" Text="NDisplayHostWin" FontSize="30" FontWeight="Bold"/><TextBlock Text="Your Windows desktop, ready to share." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1E2A3B" CornerRadius="16" Padding="13,7">
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#99A6BA" Margin="0,0,8,0"/><TextBlock x:Name="StatusBadge" Text="Host stopped" FontWeight="SemiBold"/></StackPanel>
      </Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Display &amp; streaming" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="GpuLabel" Text="Checking your display and GPU…" Foreground="{StaticResource Muted}" Margin="0,5,0,16" TextWrapping="Wrap"/>
              <DockPanel Margin="0,0,0,6"><Button x:Name="RefreshDisplaysButton" DockPanel.Dock="Right" Content="Refresh" Padding="8,3" FontSize="11" ToolTip="Refresh active displays after a monitor reconnects or changes."/><TextBlock Text="Display to share" VerticalAlignment="Center"/></DockPanel>
              <ComboBox x:Name="DisplayChoice" AutomationProperties.Name="Display to share"/>
              <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Frame rate" Margin="0,0,0,6"/><ComboBox x:Name="FpsChoice" AutomationProperties.Name="Frame rate"><ComboBoxItem Content="30 fps"/><ComboBoxItem Content="60 fps" IsSelected="True"/><ComboBoxItem Content="90 fps"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Max bitrate · adapts to link" Margin="0,0,0,6"/><ComboBox x:Name="BitrateChoice" AutomationProperties.Name="Bitrate" ToolTip="Higher values use more network bandwidth. Try a lower limit when a busy link causes stutter."><ComboBoxItem Content="20 Mbps"/><ComboBoxItem Content="40 Mbps"/><ComboBoxItem Content="60 Mbps" IsSelected="True"/><ComboBoxItem Content="80 Mbps"/></ComboBox></StackPanel>
              </Grid>
              <TextBlock Text="Video encoder" Margin="0,14,0,6"/><ComboBox x:Name="EncoderChoice" AutomationProperties.Name="Video encoder"/>
              <CheckBox x:Name="SendAudio" Content="Send this PC's sound to the headset" IsChecked="True" Margin="0,14,0,0"
                        ToolTip="Captures the default playback device while sound is on in the headset. The PC speakers keep playing."/>
              <CheckBox x:Name="ScreenOff" Content="Turn off this PC's screen while the headset is connected" Margin="0,10,0,4"
                        ToolTip="Like a Mac running Mac Virtual Display: this PC's screens go black and the headset still shows the desktop."/>
              <TextBlock Text="The screen comes back when the headset disconnects. Ctrl+Alt+Shift+B shows it sooner." Foreground="{StaticResource Muted}" FontSize="11" Margin="21,0,0,0" TextWrapping="Wrap"/>
              <DockPanel Margin="0,14,0,5">
                <Button x:Name="DisableInputButton" DockPanel.Dock="Right" Content="Disable input" Padding="10,6" Background="#5A3040" IsEnabled="False" Visibility="Collapsed" Margin="8,0,0,0"/>
                <CheckBox x:Name="AllowInput" Content="Allow keyboard and mouse control" ToolTip="Only enable for a client you trust. You can disable input immediately while streaming."/>
              </DockPanel>
              <TextBlock Text="Off by default. Screen sharing works without input access." Foreground="{StaticResource Muted}" FontSize="11" Margin="21,0,0,12" TextWrapping="Wrap"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Content="Start host" Background="#4A76ED" AutomationProperties.Name="Start host"/>
                <Button x:Name="StopButton" Grid.Column="2" Content="Stop host" IsEnabled="False" AutomationProperties.Name="Stop host"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
              <TextBlock Text="Live stream" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="StreamDetail" Text="Start the host, then connect from Vision Pro." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <UniformGrid Columns="3">
                <StackPanel><TextBlock x:Name="FpsValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="frames / sec" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                <StackPanel><TextBlock x:Name="BitrateValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Mbps sent" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                <StackPanel><TextBlock x:Name="EncodeValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="encode ms · median" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Existing local network" FontWeight="SemiBold" Margin="0,14,0,4"/>
              <TextBlock Text="Use the same Wi-Fi or wired network. Internet is not required." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <TextBlock Text="Local receiver address" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,13,0,5"/>
              <DockPanel><Button x:Name="CopyAddressButton" Content="Copy" Padding="11,7" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="AddressText" IsReadOnly="True" Text="Checking…"/></DockPanel>
              <Border Height="1" Background="#344157" Margin="0,17,0,14"/>
              <Expander x:Name="DirectExpander" Header="Direct Wi-Fi · no router" Foreground="#EDF1F9" FontWeight="SemiBold">
              <StackPanel Margin="0,9,0,0">
              <TextBlock Text="Create a private Wi-Fi network on this PC, then join it in Vision Pro Settings → Wi-Fi." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,10"/>
              <TextBlock Text="Network name" FontSize="11" Foreground="{StaticResource Muted}"/><TextBox x:Name="SsidText" Text="NDisplay-Direct" MaxLength="32" Margin="0,5,0,8"/>
              <TextBlock Text="Wi-Fi password" FontSize="11" Foreground="{StaticResource Muted}"/>
              <DockPanel Margin="0,5,0,10"><Button x:Name="CopyPasswordButton" Content="Copy" Padding="11,7" DockPanel.Dock="Right" Margin="8,0,0,0"/><PasswordBox x:Name="WifiPassword" Padding="10,7" Background="#101722" Foreground="White" BorderBrush="#3A4961"/></DockPanel>
              <Button x:Name="DirectButton" Content="Create direct Wi-Fi"/>
              <TextBlock x:Name="NetworkStatus" Text="The network stays off until you create it." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Background="#1B293A" BorderBrush="#3A6185" Margin="0,0,0,14" Padding="16">
            <StackPanel><TextBlock Text="Connect your Vision Pro" Foreground="#B9D6FF" FontWeight="SemiBold"/>
              <TextBlock Text="Start the host. On Vision Pro, select this PC or add the address above with Secure QUIC. Compare the pairing code on both devices." Foreground="#D0DDEE" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/></StackPanel>
          </Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="ReceiverButton" Content="Test listener" ToolTip="Check the local UDP listener and QUIC handshake."/>
            <Button x:Name="TestCardButton" Grid.Column="2" Content="Test card" ToolTip="An optional animated pattern and frame counter to reveal freezes and capture delay."/>
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <Button x:Name="LogsButton" DockPanel.Dock="Right" Content="Activity log" Padding="12,7" Margin="12,0,0,0"/>
      <TextBlock x:Name="FooterText" Text="Ready. Choose a display to begin." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
