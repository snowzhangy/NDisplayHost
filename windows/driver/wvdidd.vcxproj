<?xml version="1.0" encoding="utf-8"?>
<!--
  WVD IddCx UMDF 2 driver project. Requires the Windows Driver Kit (WDK).
  Build: msbuild wvdidd.vcxproj /p:Configuration=Release /p:Platform=x64
  Plan v2.3: this project has NOT been compiled yet — first WDK build is the
  verification pass for IddCx symbol drift (see driver/README.md).
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E3F2F6A-5B21-4E77-9A6D-32A6F4C1B0A9}</ProjectGuid>
    <RootNamespace>WvdIdd</RootNamespace>
    <ProjectName>WvdIdd</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <DriverType>UMDF</DriverType>
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <UMDF_VERSION_MINOR>33</UMDF_VERSION_MINOR>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <IndirectDisplayDriver>true</IndirectDisplayDriver>
    <IDDCX_VERSION_MAJOR>1</IDDCX_VERSION_MAJOR>
    <IDDCX_VERSION_MINOR>4</IDDCX_VERSION_MINOR>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PreprocessorDefinitions>UMDF_DRIVER;UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;IDDCX_VERSION_MAJOR=1;IDDCX_VERSION_MINOR=4;IDDCX_MINIMUM_VERSION_REQUIRED=4;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>OneCoreUAP.lib;d3d11.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="Trace.h" />
    <ClInclude Include="Edid.h" />
    <ClCompile Include="Edid.cpp" />
    <ClCompile Include="Driver.cpp" />
    <ClCompile Include="Monitor.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="wvdidd.inf" />
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
